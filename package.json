{
  "name": "agent-vis",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.6",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint src desktop/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:build": "pnpm --dir desktop build",
    "desktop:build:web": "pnpm --dir desktop build:web",
    "desktop:rust:fmt": "cargo fmt --manifest-path desktop/src-tauri/Cargo.toml --all -- --check",
    "desktop:rust:clippy": "cargo clippy --manifest-path desktop/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "desktop:rust:test": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --all-features",
    "desktop:check": "pnpm desktop:build:web && pnpm desktop:rust:fmt && pnpm desktop:rust:clippy && pnpm desktop:rust:test",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "next": "^15.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
